<!DOCTYPE html>
<html lang="pt-BR">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>QUIZ FASHION — Edição Vibrante</title>
  <link rel="preconnect" href="https://fonts.googleapis.com" />
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
  <link href="https://fonts.googleapis.com/css2?family=Archivo+Black&family=Plus+Jakarta+Sans:wght@500;700;800&family=JetBrains+Mono:wght@500;700&display=swap" rel="stylesheet" />
  <style>
    :root {
      --bg: #FFF5FA;
      --surface: #FFFFFF;
      --surface-alt: #FFF0F7;
      --ink: #140826;
      --ink-muted: #4A3566;
      --magenta: #FF1E7A;
      --purple: #7B2CBF;
      --yellow: #FFD60A;
      --cyan: #00BBF9;
      --lime: #00E676;
      --danger: #FF2E4C;
      --border: #140826;
      --shadow: 6px 6px 0px #140826;
      --shadow-sm: 4px 4px 0px #140826;
      --font-scale: 1;
    }

    body.high-contrast {
      --bg: #09090B;
      --surface: #141418;
      --surface-alt: #1F1F26;
      --ink: #FFFFFF;
      --ink-muted: #E4E4E7;
      --magenta: #FF4D94;
      --purple: #B565FF;
      --yellow: #FFE600;
      --cyan: #38BDF8;
      --lime: #22C55E;
      --danger: #FF4D6D;
      --border: #FFE600;
      --shadow: 6px 6px 0px #FFE600;
      --shadow-sm: 4px 4px 0px #FFE600;
    }

    * {
      box-sizing: border-box;
      margin: 0;
      padding: 0;
    }

    html {
      font-size: calc(16px * var(--font-scale));
    }

    body {
      font-family: 'Plus Jakarta Sans', sans-serif;
      background-color: var(--bg);
      background-image:
        radial-gradient(circle at 12% 18%, rgba(255, 30, 122, 0.14) 0%, transparent 28%),
        radial-gradient(circle at 88% 12%, rgba(0, 187, 249, 0.16) 0%, transparent 30%),
        radial-gradient(circle at 85% 85%, rgba(255, 214, 10, 0.2) 0%, transparent 32%);
      color: var(--ink);
      min-height: 100vh;
      line-height: 1.5;
      padding-bottom: 3rem;
    }

    /* Barra de Acessibilidade */
    .a11y-bar {
      background: var(--ink);
      color: #FFFFFF;
      padding: 0.65rem 1.25rem;
      display: flex;
      flex-wrap: wrap;
      align-items: center;
      justify-content: space-between;
      gap: 0.75rem;
      border-bottom: 4px solid var(--yellow);
      position: sticky;
      top: 0;
      z-index: 100;
    }

    body.high-contrast .a11y-bar {
      background: #000000;
      border-bottom: 4px solid var(--yellow);
    }

    .a11y-label {
      display: flex;
      align-items: center;
      gap: 0.5rem;
      font-weight: 800;
      font-size: 0.9rem;
      letter-spacing: 0.04em;
      text-transform: uppercase;
      color: var(--yellow);
    }

    .a11y-controls {
      display: flex;
      flex-wrap: wrap;
      gap: 0.5rem;
    }

    .a11y-btn {
      background: var(--surface);
      color: var(--ink);
      border: 2px solid var(--yellow);
      border-radius: 10px;
      padding: 0.4rem 0.8rem;
      font-family: inherit;
      font-weight: 800;
      font-size: 0.85rem;
      cursor: pointer;
      display: inline-flex;
      align-items: center;
      gap: 0.4rem;
      transition: transform 0.15s ease, background 0.15s ease;
    }

    .a11y-btn:hover, .a11y-btn:focus-visible {
      background: var(--yellow);
      color: #140826;
      transform: translateY(-2px);
      outline: 3px solid var(--cyan);
      outline-offset: 2px;
    }

    .container {
      max-width: 1080px;
      margin: 0 auto;
      padding: 1.5rem 1.25rem;
    }

    /* Header */
    .hero {
      background: linear-gradient(135deg, var(--magenta) 0%, var(--purple) 55%, var(--cyan) 100%);
      border: 4px solid var(--border);
      border-radius: 24px;
      box-shadow: var(--shadow);
      padding: 2rem;
      color: #FFFFFF;
      margin-bottom: 1.75rem;
      position: relative;
      overflow: hidden;
    }

    .hero-badge {
      display: inline-flex;
      align-items: center;
      gap: 0.5rem;
      background: var(--yellow);
      color: #140826;
      font-weight: 800;
      font-size: 0.85rem;
      padding: 0.4rem 0.9rem;
      border-radius: 999px;
      border: 3px solid #140826;
      text-transform: uppercase;
      margin-bottom: 0.85rem;
    }

    .hero-title-row {
      display: flex;
      align-items: center;
      gap: 1rem;
      flex-wrap: wrap;
    }

    .hero-icon-box {
      width: 72px;
      height: 72px;
      background: var(--yellow);
      color: #140826;
      border: 4px solid #140826;
      border-radius: 20px;
      display: grid;
      place-items: center;
      flex-shrink: 0;
      box-shadow: 4px 4px 0px #140826;
    }

    h1 {
      font-family: 'Archivo Black', sans-serif;
      font-size: clamp(2rem, 5vw, 3.25rem);
      line-height: 1.05;
      letter-spacing: -0.02em;
      text-shadow: 3px 3px 0px #140826;
    }

    .hero p {
      margin-top: 0.75rem;
      font-size: 1.05rem;
      font-weight: 700;
      max-width: 720px;
      background: rgba(20, 8, 38, 0.45);
      padding: 0.65rem 1rem;
      border-radius: 12px;
      border: 2px solid rgba(255, 255, 255, 0.35);
    }

    /* Menu Principal (Registro 21) */
    .nav-grid {
      display: grid;
      grid-template-columns: repeat(auto-fit, minmax(215px, 1fr));
      gap: 1rem;
      margin-bottom: 2rem;
    }

    .nav-btn {
      background: var(--surface);
      color: var(--ink);
      border: 4px solid var(--border);
      border-radius: 18px;
      padding: 1.1rem 1rem;
      box-shadow: var(--shadow-sm);
      cursor: pointer;
      display: flex;
      align-items: center;
      gap: 0.85rem;
      text-align: left;
      font-family: inherit;
      font-weight: 800;
      font-size: 1rem;
      transition: transform 0.15s ease, background 0.15s ease;
    }

    .nav-btn:hover, .nav-btn:focus-visible {
      transform: translate(-2px, -2px);
      outline: 3px solid var(--cyan);
      outline-offset: 2px;
    }

    .nav-btn.active {
      background: var(--yellow);
      color: #140826;
      transform: translate(-2px, -2px);
    }

    .nav-icon {
      width: 48px;
      height: 48px;
      border-radius: 14px;
      border: 3px solid #140826;
      display: grid;
      place-items: center;
      flex-shrink: 0;
      color: #FFFFFF;
    }

    .nav-icon.pink { background: var(--magenta); }
    .nav-icon.purple { background: var(--purple); }
    .nav-icon.cyan { background: var(--cyan); color: #140826; }
    .nav-icon.lime { background: var(--lime); color: #140826; }

    .nav-meta small {
      display: block;
      font-size: 0.75rem;
      opacity: 0.8;
      text-transform: uppercase;
    }

    /* Painéis */
    .panel {
      display: none;
      background: var(--surface);
      border: 4px solid var(--border);
      border-radius: 24px;
      box-shadow: var(--shadow);
      padding: 1.75rem;
    }

    .panel.active {
      display: block;
      animation: popIn 0.22s ease;
    }

    @keyframes popIn {
      from { opacity: 0; transform: translateY(8px); }
